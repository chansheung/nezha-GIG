# Dotfiles and dot directories (except .git)
.*
!.git
!.gitignore

# Python cache
__pycache__/

# Binary files
dashboard/nezha-dashboard
agent/nezha-agent

# OS files
.DS_Store
Thumbs.db

# Archives
*.gz
*.zip
*.tar.gz

# Flowcraft
.flowcraft/

# Build outputs
build/admin-dist/*
!build/admin-dist/.dockerkeep
dist/

# Vendor binaries (downloaded at build time)
build/vendor/
